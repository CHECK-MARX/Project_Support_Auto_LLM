<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SupportCaseManager.Ai.Contracts\SupportCaseManager.Ai.Contracts.csproj" />
    <ProjectReference Include="..\SupportCaseManager.Ai.Core\SupportCaseManager.Ai.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\prompts\**\*">
      <Link>prompts\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\SupportCaseManager.App\ChatGpt\GptCaseRegistrationService.cs" Link="ChatGpt\GptCaseRegistrationService.cs" />
    <Compile Include="..\SupportCaseManager.App\ChatGpt\ChatGptHistorySearchService.cs" Link="ChatGpt\ChatGptHistorySearchService.cs" />
    <Compile Include="..\SupportCaseManager.App\Dialogs\GptHandoffImportPreviewDialog.cs" Link="Dialogs\GptHandoffImportPreviewDialog.cs" />
  </ItemGroup>

</Project>
