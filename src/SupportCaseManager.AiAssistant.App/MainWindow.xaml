<Window x:Class="SupportCaseManager.AiAssistant.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource WindowTitle}"
        Width="1180"
        Height="780"
        MinWidth="980"
        MinHeight="640"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <DockPanel Margin="12" Background="{DynamicResource AppBackgroundBrush}">
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                Padding="8"
                Margin="0,8,0,0"
                Background="{DynamicResource AppPanelBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1"
                           Margin="12,0,0,0"
                           Text="{Binding GenerationState}"
                           Foreground="{DynamicResource AppMutedForegroundBrush}" />
                <TextBlock Grid.Column="2"
                           Margin="12,0,0,0"
                           Text="{Binding OperationProgressText}"
                           Foreground="{DynamicResource AppMutedForegroundBrush}" />
                <ProgressBar Grid.Row="1"
                             Grid.ColumnSpan="3"
                             Height="8"
                             Margin="0,7,0,0"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding OperationProgressPercent, Mode=OneWay}" />
            </Grid>
        </Border>

        <TabControl>
            <TabItem Header="{DynamicResource SettingsTabHeader}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Header="基本設定">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="{DynamicResource UiLanguageLabel}" />
                                <ComboBox Grid.Column="1"
                                          Width="180"
                                          HorizontalAlignment="Left"
                                          SelectedValue="{Binding UiLanguage, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Tag="ja-JP" Content="{DynamicResource LanguageJapanese}" />
                                    <ComboBoxItem Tag="en-US" Content="{DynamicResource LanguageEnglish}" />
                                </ComboBox>

                                <TextBlock Grid.Row="1" Text="{DynamicResource DarkModeLabel}" />
                                <CheckBox Grid.Row="1"
                                          Grid.Column="1"
                                          IsChecked="{Binding UseDarkMode, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="2" Text="選択製品" />
                                <ComboBox Grid.Row="2"
                                          Grid.Column="1"
                                          ItemsSource="{Binding Products}"
                                          SelectedItem="{Binding SelectedProductKnowledge, UpdateSourceTrigger=PropertyChanged}"
                                          DisplayMemberPath="ProductName" />

                                <TextBlock Grid.Row="3" Text="回答品質モード" />
                                <ComboBox Grid.Row="3"
                                          Grid.Column="1"
                                          SelectedValue="{Binding AnswerQualityMode, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Tag="Fast" Content="高速" />
                                    <ComboBoxItem Tag="Standard" Content="標準" />
                                    <ComboBoxItem Tag="Quality" Content="高品質" />
                                    <ComboBoxItem Tag="Custom" Content="カスタム" />
                                </ComboBox>

                                <TextBlock Grid.Row="4" Text="現在の回答モデル" />
                                <ComboBox Grid.Row="4"
                                          Grid.Column="1"
                                          ItemsSource="{Binding AvailableModels}"
                                          SelectedItem="{Binding ChatModel, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="False" />
                                <Button Grid.Row="4"
                                        Grid.Column="2"
                                        Content="接続確認"
                                        Command="{Binding CheckOllamaConnectionCommand}" />

                                <TextBlock Grid.Row="5" Text="Ollama接続状態" />
                                <TextBlock Grid.Row="5"
                                           Grid.Column="1"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding OllamaConnectionResultText, Mode=OneWay}"
                                           TextWrapping="Wrap" />

                                <TextBlock Grid.Row="6" Text="ナレッジ状態" />
                                <TextBox Grid.Row="6"
                                         Grid.Column="1"
                                         Text="{Binding KnowledgeStatusText, Mode=OneWay}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="90" />
                                <Button Grid.Row="6"
                                        Grid.Column="2"
                                        VerticalAlignment="Top"
                                        Content="ナレッジを更新"
                                        Command="{Binding UpdateKnowledgeCommand}" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Codex App Server">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Codex実行ファイル" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding CodexExecutablePath, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2"
                                        Content="参照"
                                        Command="{Binding SelectCodexExecutableCommand}" />

                                <TextBlock Grid.Row="1" Text="接続テスト" />
                                <Button Grid.Row="1"
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        Content="Codexへ接続"
                                        Command="{Binding Codex.ConnectCommand}" />
                                <Button Grid.Row="1"
                                        Grid.Column="2"
                                        Content="再接続"
                                        Command="{Binding Codex.ReconnectCommand}" />

                                <TextBlock Grid.Row="2" Text="Codexバージョン" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                           Text="{Binding Codex.Version, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="3" Text="App Server" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                           Text="{Binding Codex.ConnectionDetails, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="4" Text="ChatGPT認証" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                           Text="{Binding Codex.AccountStatus, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="5" Text="既定モデル" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                                           Text="{Binding Codex.Model, Mode=OneWay}" TextWrapping="Wrap" />
                            </Grid>
                        </GroupBox>

                        <Expander Header="詳細設定" IsExpanded="False">
                            <StackPanel>
                        <GroupBox Header="{DynamicResource AiDataFoldersHeader}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="{DynamicResource AiDataFolderLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding AiDataFolder, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2" Content="{DynamicResource SelectButton}" Command="{Binding SelectAiDataFolderCommand}" />

                                <TextBlock Grid.Row="1" Text="{DynamicResource BaseFolderLabel}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BaseFolder, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Row="1" Grid.Column="2" Content="{DynamicResource SelectButton}" Command="{Binding SelectBaseFolderCommand}" />

                                <TextBlock Grid.Row="2" Text="{DynamicResource ClosedCasesFolderLabel}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CloseFolder, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Row="2" Grid.Column="2" Content="{DynamicResource SelectButton}" Command="{Binding SelectCloseFolderCommand}" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="{DynamicResource RagLabEvidenceSettingsHeader}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <CheckBox Grid.ColumnSpan="3"
                                          Content="{DynamicResource UseRagLabEvidenceLabel}"
                                          IsChecked="{Binding UseRagLabEvidence}" />

                                <TextBlock Grid.Row="1" Text="{DynamicResource RagLabEvidenceFileLabel}" />
                                <TextBox Grid.Row="1"
                                         Grid.Column="1"
                                         Text="{Binding RagLabEvidenceFilePath, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding UseRagLabEvidence}" />
                                <Button Grid.Row="1"
                                        Grid.Column="2"
                                        Content="{DynamicResource SelectButton}"
                                        Command="{Binding SelectRagLabEvidenceFileCommand}"
                                        IsEnabled="{Binding UseRagLabEvidence}" />

                                <TextBlock Grid.Row="2" Text="{DynamicResource RagLabReadinessFileLabel}" />
                                <TextBox Grid.Row="2"
                                         Grid.Column="1"
                                         Text="{Binding RagLabBaselineReadinessFilePath, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding UseRagLabEvidence}" />
                                <Button Grid.Row="2"
                                        Grid.Column="2"
                                        Content="{DynamicResource SelectButton}"
                                        Command="{Binding SelectRagLabBaselineReadinessFileCommand}"
                                        IsEnabled="{Binding UseRagLabEvidence}" />

                                <TextBlock Grid.Row="3" Text="{DynamicResource RagLabEvidenceMaxItemsLabel}" />
                                <TextBox Grid.Row="3"
                                         Grid.Column="1"
                                         Text="{Binding RagLabEvidenceMaxItems, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding UseRagLabEvidence}" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="現在の使用コンテキスト">
                            <StackPanel>
                                <TextBox Text="{Binding CurrentProductContextText, Mode=OneWay}"
                                         AcceptsReturn="True"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         MinHeight="100" />
                                <TextBlock Text="{Binding ManualFolderUsageText, Mode=OneWay}"
                                           Foreground="{DynamicResource AppMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{DynamicResource CaseNoteIndexHeader}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="{DynamicResource AiIndexFolderLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding AiIndexFolder, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2" Content="{DynamicResource SelectButton}" Command="{Binding SelectAiIndexFolderCommand}" />

                                <Button Grid.Row="1"
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        Content="{DynamicResource BuildPastCaseIndexButton}"
                                        Command="{Binding BuildIndexCommand}" />

                                <TextBox Grid.Row="2"
                                         Grid.Column="1"
                                         Grid.ColumnSpan="2"
                                         Text="{Binding IndexBuildResultText, Mode=OneWay}"
                                         AcceptsReturn="True"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         MinHeight="80" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="{DynamicResource ManualIndexHeader}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="{DynamicResource ManualFolderLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding ManualFolder, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2" Content="{DynamicResource SelectButton}" Command="{Binding SelectManualFolderCommand}" />

                                <Button Grid.Row="1"
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        Content="{DynamicResource BuildManualIndexButton}"
                                        Command="{Binding BuildManualIndexCommand}" />

                                <TextBox Grid.Row="2"
                                         Grid.Column="1"
                                         Grid.ColumnSpan="2"
                                         Text="{Binding ManualIndexBuildResultText, Mode=OneWay}"
                                         AcceptsReturn="True"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         MinHeight="80" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="製品別ナレッジ設定">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="既存設定ファイル" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding SupportToolSettingsFilePath, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="選択" Command="{Binding SelectSupportToolSettingsFileCommand}" />
                                    <Button Content="読み込み" Command="{Binding LoadSupportToolSettingsCommand}" Margin="6,0,0,0" />
                                </StackPanel>

                                <TextBlock Grid.Row="1" Text="製品一覧" />
                                <DataGrid Grid.Row="1"
                                          Grid.Column="1"
                                          Grid.ColumnSpan="2"
                                          ItemsSource="{Binding Products}"
                                          SelectedItem="{Binding SelectedProductKnowledge}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          MinHeight="120">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="製品名" Binding="{Binding ProductName, Mode=OneWay}" Width="160" />
                                        <DataGridCheckBoxColumn Header="有効" Binding="{Binding IsEnabled, Mode=TwoWay}" Width="70" IsReadOnly="False" />
                                        <DataGridTextColumn Header="ベースフォルダ" Binding="{Binding BaseFolder, Mode=OneWay}" Width="2*" />
                                        <DataGridTextColumn Header="クローズフォルダ" Binding="{Binding CloseFolder, Mode=OneWay}" Width="2*" />
                                        <DataGridTextColumn Header="マニュアル" Binding="{Binding ManualFoldersSummary, Mode=OneWay}" Width="2*" />
                                        <DataGridTextColumn Header="URL" Binding="{Binding DocumentUrlsSummary, Mode=OneWay}" Width="2*" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Grid.Row="2" Text="選択製品" />
                                <TextBox Grid.Row="2"
                                         Grid.Column="1"
                                         Grid.ColumnSpan="2"
                                         Text="{Binding SelectedProductKnowledge.ProductName, Mode=OneWay}"
                                         IsReadOnly="True" />

                                <TextBlock Grid.Row="3" Text="ベースフォルダ" />
                                <TextBox Grid.Row="3"
                                         Grid.Column="1"
                                         Grid.ColumnSpan="2"
                                         Text="{Binding SelectedProductKnowledge.BaseFolder, Mode=OneWay}"
                                         IsReadOnly="True" />

                                <TextBlock Grid.Row="4" Text="クローズフォルダ" />
                                <TextBox Grid.Row="4"
                                         Grid.Column="1"
                                         Grid.ColumnSpan="2"
                                         Text="{Binding SelectedProductKnowledge.CloseFolder, Mode=OneWay}"
                                         IsReadOnly="True" />

                                <TextBlock Grid.Row="5" Text="製品別索引" />
                                <TextBox Grid.Row="5"
                                         Grid.Column="1"
                                         Grid.ColumnSpan="2"
                                         Text="{Binding SelectedProductIndexFolder, Mode=OneWay}"
                                         IsReadOnly="True" />

                                <TextBlock Grid.Row="6" Text="マニュアルフォルダ" />
                                <DockPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Vertical" Margin="8,0,0,0">
                                        <Button Content="追加" Command="{Binding AddProductManualFolderCommand}" />
                                        <Button Content="削除" Command="{Binding RemoveProductManualFolderCommand}" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding SelectedProductKnowledge.ManualFolders}"
                                             SelectedItem="{Binding SelectedManualFolderPath}"
                                             MinHeight="70" />
                                </DockPanel>

                                <TextBlock Grid.Row="7" Text="公式URL登録" />
                                <DockPanel Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBox Width="520"
                                                 Text="{Binding NewDocumentUrl, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Content="追加" Command="{Binding AddProductDocumentUrlCommand}" Margin="6,0,0,0" />
                                        <Button Content="削除" Command="{Binding RemoveProductDocumentUrlCommand}" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding SelectedProductKnowledge.DocumentUrls}"
                                             SelectedItem="{Binding SelectedDocumentUrl}"
                                             MinHeight="70" />
                                </DockPanel>

                                <TextBlock Grid.Row="8" Text="クロール深度" />
                                <TextBox Grid.Row="8"
                                         Grid.Column="1"
                                         Text="{Binding SelectedProductKnowledge.CrawlMaxDepth, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="9" Text="最大ページ数" />
                                <TextBox Grid.Row="9"
                                         Grid.Column="1"
                                         Text="{Binding SelectedProductKnowledge.CrawlMaxPages, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="10" Text="状態" />
                                <TextBox Grid.Row="10"
                                         Grid.Column="1"
                                         Grid.ColumnSpan="2"
                                         Text="{Binding ProductKnowledgeStatusText, Mode=OneWay}"
                                         IsReadOnly="True" />

                            </Grid>
                        </GroupBox>

                        <GroupBox Header="{DynamicResource LlmSettingsHeader}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="{DynamicResource ProviderLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding LlmProvider, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="1" Text="{DynamicResource OllamaEndpointLabel}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OllamaEndpoint, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="2" Text="{DynamicResource ChatModelLabel}" />
                                <ComboBox Grid.Row="2"
                                          Grid.Column="1"
                                          ItemsSource="{Binding AvailableModels}"
                                          SelectedItem="{Binding ChatModel, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="False" />

                                <TextBlock Grid.Row="3" Text="{DynamicResource EmbeddingModelLabel}" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding EmbeddingModel, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="4" Text="{DynamicResource MaxEvidenceItemsLabel}" />
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding MaxEvidenceItems, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="5" Text="{DynamicResource MaxPromptCharsLabel}" />
                                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding MaxPromptChars, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="6" Text="{DynamicResource TemperatureLabel}" />
                                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Temperature, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="7" Text="{DynamicResource MaxOutputTokensLabel}" />
                                <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding MaxOutputTokens, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="8" Text="{DynamicResource ContextWindowTokensLabel}" />
                                <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding ContextWindowTokens, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="9" Text="{DynamicResource TimeoutSecondsLabel}" />
                                <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </GroupBox>

                        <WrapPanel>
                            <CheckBox Content="{DynamicResource EnableCloudLlmLabel}" IsChecked="{Binding EnableCloudLlm}" />
                            <CheckBox Content="{DynamicResource MaskSensitiveDataForCloudLabel}" IsChecked="{Binding MaskSensitiveDataForCloud}" />
                            <CheckBox Content="{DynamicResource DisableThinkingLabel}" IsChecked="{Binding DisableThinking}" Margin="12,0,0,0" />
                            <CheckBox Content="{DynamicResource SkipGenerationWhenNoEvidenceLabel}" IsChecked="{Binding SkipGenerationWhenNoEvidence}" Margin="12,0,0,0" />
                            <CheckBox Content="{DynamicResource EnableTopNFallbackLabel}" IsChecked="{Binding EnableTopNFallback}" Margin="12,0,0,0" />
                            <CheckBox Content="質問適合性を考慮した根拠選定" IsChecked="{Binding UseQuestionAwareEvidenceSelection}" Margin="12,0,0,0" />
                            <CheckBox Content="{DynamicResource UseAnswerQualityGateLabel}"
                                      IsChecked="{Binding UseAnswerQualityGate}"
                                      Margin="12,0,0,0" />
                            <CheckBox Content="{DynamicResource UsePhase175QualityControlsLabel}"
                                      IsChecked="{Binding UsePhase175QualityControls}"
                                      Margin="12,0,0,0" />
                            <CheckBox Content="{DynamicResource UseCoverageAwareEvidenceSelectionLabel}"
                                      IsChecked="{Binding UseCoverageAwareEvidenceSelection}"
                                      Margin="12,0,0,0" />
                            <TextBlock Text="{DynamicResource CoverageAwareMaxEvidenceItemsLabel}" Margin="12,4,4,0" />
                            <TextBox Width="42"
                                     Text="{Binding CoverageAwareMaxEvidenceItems, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding UseCoverageAwareEvidenceSelection}" />
                            <CheckBox Content="{DynamicResource UseRustEvidenceSelectorLabel}"
                                      IsChecked="{Binding UseRustEvidenceSelector}"
                                      IsEnabled="{Binding UseCoverageAwareEvidenceSelection}"
                                      Margin="12,0,0,0" />
                            <CheckBox Content="{DynamicResource EnableRustSelectorShadowModeLabel}"
                                      IsChecked="{Binding EnableRustSelectorShadowMode}"
                                      IsEnabled="{Binding UseCoverageAwareEvidenceSelection}"
                                      Margin="12,0,0,0" />
                            <TextBlock Text="{DynamicResource RustEvidenceSelectorTimeoutLabel}" Margin="12,4,4,0" />
                            <TextBox Width="72"
                                     Text="{Binding RustEvidenceSelectorTimeoutMs, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding UseCoverageAwareEvidenceSelection}" />
                            <TextBlock Text="{DynamicResource ShadowMinimumRunsLabel}" Margin="12,4,4,0" />
                            <TextBox Width="58"
                                     Text="{Binding ShadowMinimumRunsForReadiness, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding EnableRustSelectorShadowMode}" />
                            <TextBlock Text="{DynamicResource ShadowMaxRecordsLabel}" Margin="12,4,4,0" />
                            <TextBox Width="64"
                                     Text="{Binding ShadowMaxStoredRecords, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding EnableRustSelectorShadowMode}" />
                            <TextBlock Text="ランキング方式" Margin="12,4,4,0" />
                            <ComboBox Width="100"
                                      IsEnabled="{Binding UseQuestionAwareEvidenceSelection}"
                                      SelectedValue="{Binding EvidenceRankingMode, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Tag="Phase15" Content="Phase 15" />
                                <ComboBoxItem Tag="Phase16" Content="Phase 16" />
                            </ComboBox>
                        </WrapPanel>

                        <GroupBox Header="モデル比較 / 推奨設定">
                            <TextBox Text="{Binding ModelRecommendationText, Mode=OneWay}"
                                     AcceptsReturn="True"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="80" />
                        </GroupBox>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource CheckOllamaConnectionButton}" Command="{Binding CheckOllamaConnectionCommand}" />
                            <Button Content="Ollama本番生成ミニテスト" Command="{Binding RunOllamaProductionMiniTestCommand}" />
                            <Button Content="モデル一覧を更新" Command="{Binding RefreshOllamaModelsCommand}" />
                            <Button Content="モデル互換性テスト" Command="{Binding RunModelCompatibilityTestCommand}" />
                            <Button Content="設定を初期値に戻す" Command="{Binding ResetSettingsCommand}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="完全再構築" Command="{Binding RebuildKnowledgeCommand}" />
                            <Button Content="公式Docsのみ更新" Command="{Binding UpdateOfficialKnowledgeCommand}" />
