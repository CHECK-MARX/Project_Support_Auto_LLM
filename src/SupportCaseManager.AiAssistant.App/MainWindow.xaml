                                <WrapPanel Grid.Row="4" Margin="0,8,0,0">
                                    <Button Content="送信" Command="{Binding Codex.SendCommand}" />
                                    <Button Content="中止" Command="{Binding Codex.StopCommand}" />
                                    <Button Content="回答をコピー" Command="{Binding Codex.CopyAnswerCommand}" />
                                    <Button Content="この回答を返信案へ反映" Command="{Binding Codex.ApplyReplyCommand}" />
                                    <Button Content="この回答を調査メモへ反映" Command="{Binding Codex.ApplyMemoCommand}" />
                                    <Button Content="返信案反映を元に戻す" Command="{Binding Codex.UndoReplyCommand}" />
                                    <Button Content="メモ反映を元に戻す" Command="{Binding Codex.UndoMemoCommand}" />
                                    <Button Content="Codexで最終レビュー" Command="{Binding Codex.FinalReviewCommand}" />
                                </WrapPanel>
                            </Grid>
                        </GroupBox>

                        <Expander Header="成果物（ユーザー確認後に作成）"
                                  IsExpanded="True"
                                  Margin="0,0,0,8">
                            <StackPanel>
                                <GroupBox Header="成果物作成計画">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="処理状態" />
                                        <Grid Grid.Column="1" Grid.ColumnSpan="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Height="10"
                                                         Minimum="0"
                                                         Maximum="100"
                                                         Value="{Binding Codex.ArtifactProgressPercent, Mode=OneWay}"
                                                         VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="12,0,0,0"
                                                       Text="{Binding Codex.ArtifactStateText, Mode=OneWay}" />
                                        </Grid>

                                        <TextBlock Grid.Row="1" Text="元ファイル" />
                                        <TextBox Grid.Row="1"
                                                 Grid.Column="1"
                                                 Text="{Binding Codex.ArtifactSourceFullPath, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap" />
                                        <Button Grid.Row="1"
                                                Grid.Column="2"
                                                Content="元ファイルを開く"
                                                Command="{Binding Codex.OpenArtifactSourceCommand}" />

                                        <TextBlock Grid.Row="2" Text="成果物の種類" />
                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="1"
                                                   Grid.ColumnSpan="2"
                                                   Text="{Binding Codex.ArtifactKindText, Mode=OneWay}" />

                                        <TextBlock Grid.Row="3" Text="処理内容" />
                                        <TextBlock Grid.Row="3"
                                                   Grid.Column="1"
                                                   Grid.ColumnSpan="2"
                                                   Text="{Binding Codex.ArtifactProcessDescription, Mode=OneWay}"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Grid.Row="4" Text="保存先フォルダ" />
                                        <TextBox Grid.Row="4"
                                                 Grid.Column="1"
                                                 Text="{Binding Codex.ArtifactDestinationFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsReadOnly="False"
                                                 TextWrapping="Wrap" />
                                        <WrapPanel Grid.Row="4" Grid.Column="2">
                                            <Button Content="保存先を変更"
                                                    Command="{Binding Codex.ChooseArtifactDestinationCommand}" />
                                            <Button Content="保存先を開く"
                                                    Command="{Binding Codex.OpenArtifactDestinationCommand}" />
                                        </WrapPanel>

                                        <TextBlock Grid.Row="5" Text="出力ファイル名" />
                                        <TextBox Grid.Row="5"
                                                 Grid.Column="1"
                                                 Text="{Binding Codex.ArtifactOutputFileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsReadOnly="False" />
                                        <WrapPanel Grid.Row="5" Grid.Column="2">
                                            <Button Content="既定名"
                                                    Command="{Binding Codex.ResetArtifactOutputNameCommand}" />
                                            <Button Content="連番で保存"
                                                    Command="{Binding Codex.UseNumberedArtifactNameCommand}" />
                                        </WrapPanel>

                                        <TextBlock Grid.Row="6" Text="上書き／原本" />
                                        <StackPanel Grid.Row="6"
                                                    Grid.Column="1"
                                                    Grid.ColumnSpan="2"
                                                    Orientation="Horizontal">
                                            <TextBlock Text="{Binding Codex.ArtifactOverwriteText, Mode=OneWay}" />
                                            <TextBlock Text=" ／ " />
                                            <TextBlock Text="{Binding Codex.ArtifactSourceProtectionText, Mode=OneWay}" />
                                            <TextBlock Text=" ／ 保存先: " />
                                            <TextBlock Text="{Binding Codex.ArtifactDestinationCreationText, Mode=OneWay}" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="7" Text="対象要素" />
                                        <TextBlock Grid.Row="7"
                                                   Grid.Column="1"
                                                   Grid.ColumnSpan="2"
                                                   Text="{Binding Codex.ArtifactTranslationSummary, Mode=OneWay}" />
                                    </Grid>
                                </GroupBox>

                                <WrapPanel Margin="0,0,0,8">
                                    <Button Content="実行内容を確認"
                                            Command="{Binding Codex.PrepareArtifactPlanCommand}" />
                                    <Button Content="英訳Excelを作成"
                                            Command="{Binding Codex.CreateExcelArtifactCommand}" />
                                    <Button Content="キャンセル"
                                            Command="{Binding Codex.CancelArtifactCommand}" />
                                    <Button Content="作成ファイルを開く"
                                            Command="{Binding Codex.OpenCreatedArtifactCommand}" />
                                </WrapPanel>

                                <GroupBox Header="翻訳プレビュー（原文と英訳）">
                                    <DataGrid ItemsSource="{Binding Codex.ArtifactTranslationPreview}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="True"
                                              MaxHeight="280"
                                              SelectionMode="Single">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="種類" Binding="{Binding TargetKindText}" Width="110" />
                                            <DataGridTextColumn Header="シート" Binding="{Binding Sheet}" Width="130" />
                                            <DataGridTextColumn Header="対象" Binding="{Binding Cell}" Width="110" />
                                            <DataGridTextColumn Header="原文" Binding="{Binding SourceText}" Width="*" />
                                            <DataGridTextColumn Header="英訳" Binding="{Binding TranslatedText}" Width="*" />
                                            <DataGridTextColumn Header="判定" Binding="{Binding TargetText}" Width="150" />
                                            <DataGridTextColumn Header="表示形式" Binding="{Binding NumberFormat}" Width="120" />
                                            <DataGridTextColumn Header="数式" Binding="{Binding FormulaText}" Width="65" />
                                            <DataGridTextColumn Header="コメント" Binding="{Binding CommentText}" Width="75" />
                                            <DataGridTextColumn Header="結合セル" Binding="{Binding MergedRange}" Width="100" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </GroupBox>

                                <GroupBox Header="警告・処理結果">
                                    <StackPanel>
                                        <TextBox Text="{Binding Codex.ArtifactWarnings, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="55" />
                                        <TextBox Text="{Binding Codex.ArtifactResultText, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="80" />
                                        <TextBlock Text="{Binding Codex.CreatedArtifactPath, Mode=OneWay}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="メーカー向け確認案（編集可能・自動送信しません）">
                                    <StackPanel>
                                        <TextBox Text="{Binding Codex.ManufacturerMailDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True"
                                                 IsReadOnly="False"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 MinHeight="180" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Content="メーカー確認メール案を作成"
                                                    Command="{Binding Codex.GenerateManufacturerMailCommand}" />
                                            <Button Content="メール案をコピー"
                                                    Command="{Binding Codex.CopyManufacturerMailCommand}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </Expander>

                        <GroupBox Header="Codex技術回答案">
                            <TextBox Text="{Binding Codex.TechnicalAnswer, Mode=OneWay}"
                                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" />
                        </GroupBox>
                        <GroupBox Header="レビュー後の回答案">
                            <TextBox Text="{Binding Codex.ReviewAnswer, Mode=OneWay}"
                                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" />
                        </GroupBox>
                        <GroupBox Header="レビュー変更点・要確認事項・警告">
                            <StackPanel>
                                <TextBox Text="{Binding Codex.ReviewChanges, Mode=OneWay}"
                                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" />
                                <TextBlock Text="{Binding Codex.ReviewWarnings, Mode=OneWay}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="RAG Lab Evidence A/B比較">
                            <StackPanel>
                                <WrapPanel Margin="0,0,0,8">
                                    <Button Content="A（Evidenceなし）として記録"
                                            Command="{Binding Codex.CaptureAbBaselineCommand}" />
                                    <Button Content="B（Evidenceあり）として記録"
                                            Command="{Binding Codex.CaptureAbEvidenceCommand}" />
                                    <Button Content="A/Bを比較"
                                            Command="{Binding Codex.CompareAbCommand}" />
                                </WrapPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="A: " />
                                    <TextBlock Grid.Column="1" Text="{Binding Codex.BaselineAbStatus, Mode=OneWay}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1" Text="B: " />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Codex.EvidenceAbStatus, Mode=OneWay}" TextWrapping="Wrap" />
                                </Grid>
                                <TextBox Text="{Binding Codex.AbComparisonText, Mode=OneWay}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         MinHeight="180" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="警告・エラー">
                            <StackPanel>
                                <TextBlock Text="{Binding Codex.WarningText, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Codex.ErrorText, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock Foreground="{DynamicResource AppMutedForegroundBrush}">
                                    <Run Text="診断ログ: " /><Run Text="{Binding Codex.DiagnosticsPath, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource DraftResultTabHeader}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <Expander Header="生成情報" IsExpanded="False">
                            <TextBox Text="{Binding DraftProviderStatusText, Mode=OneWay}"
                                     AcceptsReturn="True"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="80" />
                        </Expander>

                        <GroupBox Header="{DynamicResource CustomerReplyDraftHeader}">
                            <TextBox Text="{Binding CustomerReplyDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     IsReadOnly="False"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="150" />
                        </GroupBox>

                        <GroupBox Header="回答可能判定">
                            <TextBox Text="{Binding AnswerReadinessText, Mode=OneWay}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap" />
                        </GroupBox>

                        <GroupBox Header="{DynamicResource NeedConfirmationsHeader}">
                            <TextBox Text="{Binding NeedConfirmationsText, Mode=OneWay}"
                                     AcceptsReturn="True"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="80" />
                        </GroupBox>

                        <GroupBox Header="確定済みFact">
                            <TextBox Text="{Binding ResolvedFactsText, Mode=OneWay}"
                                     AcceptsReturn="True"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="70" />
                        </GroupBox>

                        <GroupBox Header="{DynamicResource EvidenceHeader}">
                            <TextBox Text="{Binding EvidenceText, Mode=OneWay}"
                                     AcceptsReturn="True"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="80" />
                        </GroupBox>

                        <Expander Header="詳細診断" IsExpanded="False">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource ConfidenceLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding ConfidenceText}" />
                                </Grid>
                                <GroupBox Header="{DynamicResource UsedEvidenceHeader}">
                                    <TextBox Text="{Binding UsedSourcesText, Mode=OneWay}"
                                             AcceptsReturn="True"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             MinHeight="100" />
                                </GroupBox>
                                <TextBox Text="{Binding GenerationDiagnosticsText, Mode=OneWay}"
                                         AcceptsReturn="True"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         MinHeight="90" />
                            </StackPanel>
                        </Expander>

                        <Expander Header="{DynamicResource InternalMemoHeader}" IsExpanded="False">
                            <TextBox Text="{Binding InternalMemo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     IsReadOnly="False"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="90" />
                        </Expander>

                        <Expander Header="{DynamicResource WarningsHeader}" IsExpanded="False">
                            <TextBox Text="{Binding WarningsText, Mode=OneWay}"
                                     AcceptsReturn="True"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="70" />
                        </Expander>

                        <TextBlock Text="{Binding SavedDraftPath}" Foreground="{DynamicResource AppMutedForegroundBrush}" TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource CopyCustomerReplyButton}" Command="{Binding CopyCustomerReplyCommand}" />
                            <Button Content="再生成" Command="{Binding GenerateDraftCommand}" />
                            <Button Content="高品質モデルで再生成" Command="{Binding GenerateHighQualityDraftCommand}" />
                            <Button Content="{DynamicResource CopyInternalMemoButton}" Command="{Binding CopyInternalMemoCommand}" />
                            <Button Content="{DynamicResource CopyAllButton}" Command="{Binding CopyAllCommand}" />
                            <Button Content="{DynamicResource SaveDraftButton}" Command="{Binding SaveDraftCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource LogsDiagnosticsTabHeader}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Header="{DynamicResource DiagnosticsStatusHeader}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="{DynamicResource CurrentStatusLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="1" Text="{DynamicResource LastResultLabel}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastOperationResult}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="2" Text="{DynamicResource LogFileLabel}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LogFilePath}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="3" Text="{DynamicResource ErrorLabel}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ErrorText}" Foreground="{DynamicResource AppWarningBrush}" TextWrapping="Wrap" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="RAG / 生成診断">
                            <TextBox Text="{Binding RagDiagnosticsText, Mode=OneWay}"
                                     AcceptsReturn="True"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="180" />
                        </GroupBox>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource WriteTestLogButton}" Command="{Binding WriteTestLogCommand}" />
                            <Button Content="{DynamicResource OpenLogButton}" Command="{Binding OpenLogCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
