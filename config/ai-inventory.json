{
  "applicationName": "SupportCaseManager AI Assistant",
  "applicationType": ".NET WPF desktop application",
  "aiFeatures": [
    "support answer generation",
    "RAG evidence retrieval",
    "draft generation",
    "evidence-based response assistance"
  ],
  "aiProvider": {
    "name": "Ollama",
    "type": "local LLM runtime",
    "endpoint": "http://localhost:11434/api/chat",
    "embeddingEndpoint": "http://localhost:11434/api/embed",
    "cloudTransmissionDefault": false
  },
  "endpoint": "http://localhost:11434/api/chat",
  "models": [
    {
      "name": "qwen3:8b",
      "provider": "Ollama",
      "deployment": "local",
      "usage": "fast support answer generation preset",
      "thinkingDefault": false
    },
    {
      "name": "qwen3:14b",
      "provider": "Ollama",
      "deployment": "local",
      "usage": "backward-compatible custom/default support answer model",
      "thinkingDefault": false
    },
    {
      "name": "gemma4:26b",
      "provider": "Ollama",
      "deployment": "local",
      "usage": "standard support answer generation preset",
      "thinkingParameterType": "None",
      "structuredOutputMode": "PlainText"
    },
    {
      "name": "gemma4:31b",
      "provider": "Ollama",
      "deployment": "local",
      "usage": "quality support answer generation preset",
      "thinkingParameterType": "None",
      "structuredOutputMode": "PlainText"
    },
    {
      "name": "gpt-oss:120b-cloud",
      "provider": "Ollama",
      "deployment": "configured runtime",
      "usage": "optional cloud-quality support answer generation profile",
      "thinkingParameterType": "None",
      "structuredOutputMode": "PlainText"
    }
  ],
  "aibom": {
    "cycloneDxPath": "config/aibom.cdx.json",
    "humanReadablePath": "docs/AI_BOM.md",
    "usageDocumentationPath": "docs/AI_USAGE.md",
    "description": "Manual AI-BOM evidence for AI Supply Chain review. Automatic Global Inventory ingestion is not guaranteed."
  },
  "rag": {
    "enabled": true,
    "description": "Routes product-scoped evidence by question type, combines keyword and optional Ollama embedding ranking with reciprocal-rank fusion, removes duplicates, and passes selected evidence to Ollama.",
    "embedding": {
      "endpoint": "http://localhost:11434/api/embed",
      "modelSource": "settings.json LlmProvider.EmbeddingModel",
      "indexFile": "embeddings-index.json",
      "differentialUpdate": true,
      "keywordFallback": true,
      "automaticPull": false
    },
    "dataSources": [
      "PastCaseNote",
      "Manual",
      "OfficialDoc",
      "CuratedFactCatalog"
    ],
    "indexPathPattern": "ai-index/products/<productName>/",
    "sourcePriority": [
      "CuratedFactCatalog",
      "OfficialDoc",
      "Manual",
      "PastCaseNote"
    ]
  },
  "ragDataSources": [
    "PastCaseNote",
    "Manual",
    "OfficialDoc",
    "CuratedFactCatalog"
  ],
  "indexes": [
    {
      "type": "AI index",
      "pathPattern": "ai-index/products/<productName>/",
      "description": "Product-scoped differential RAG index with knowledge-manifest.json, optional embeddings-index.json, reciprocal-rank fusion, and keyword fallback without a separate vector database."
    }
  ],
  "prompts": [
    {
      "name": "support answer system prompt",
      "path": "src/SupportCaseManager.Ai.Core/Prompts/support-answer-system-prompt.md",
      "usage": "system instructions for evidence-based support answer generation"
    },
    {
      "name": "support answer output prompt",
      "path": "src/SupportCaseManager.Ai.Core/Prompts/support-answer-output-prompt.md",
      "usage": "output format instructions for customer reply, internal memo, required checks, confidence, and warnings"
    }
  ],
  "generatedArtifacts": [
    {
      "type": "AI draft",
      "path": "ai-data/drafts/",
      "description": "Generated support answer drafts saved for human review"
    }
  ],
  "logs": [
    {
      "type": "AI assistant log",
      "path": "ai-data/logs/AiAssistant.log",
      "piiHandling": "mask sensitive values before logging"
    }
  ],
  "privacy": {
    "localOnlyDefault": true,
    "cloudLlmDefault": false,
    "externalTransmissionDefault": false,
    "piiMaskingRequiredForCloud": true
  },
  "safetyControls": {
    "noAutomaticCustomerEmail": true,
    "noAutomaticReply": true,
    "noAutomaticCaseClose": true,
    "noAutomaticWriteBackToExistingNotes": true,
    "humanReviewRequired": true
  },
  "humanReview": {
    "required": true,
    "description": "Generated drafts are assistance outputs and must be reviewed by a support engineer before use."
  },
  "cloudLlmDefault": false,
  "localOnlyDefault": true
}
